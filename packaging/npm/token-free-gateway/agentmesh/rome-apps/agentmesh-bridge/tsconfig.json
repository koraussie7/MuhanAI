{
	"compilerOptions": {
		// Inlined verbatim from `@rome-os/app-web-sdk@0.3.4` `tsconfig.app.json`.
		//
		// This app deliberately keeps its own `pnpm-lock.yaml` and is *not* a
		// member of the agentmesh workspace, so `@rome-os/*` is never installed in
		// CI. An `"extends": "@rome-os/app-web-sdk/tsconfig.app.json"` therefore
		// makes vite/esbuild fail while transforming `src/lib/*.ts` through the
		// root vitest project (`TSConfckParseError: failed to resolve "extends"`),
		// which breaks `tests/rome-bridge-gateway.test.ts` at collection time.
		// Keeping the options inline makes the file self-contained; re-check them
		// against the SDK tsconfig when the SDK is upgraded.
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"types": ["node"],
		"paths": {
			"@/*": ["./src/web/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"]
}
