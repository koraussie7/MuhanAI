// MuhanAI Prisma schema
// Setup:
//   1. cp .env.example .env
//   2. docker compose up -d postgres
//   3. npx prisma migrate dev --name init
//   4. npx prisma generate

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// User + Personal MCP
// ---------------------------------------------------------------------------

model User {
  id            String    @id // app-level userId (not forced cuid — allows external auth ids)
  email         String?   @unique
  name          String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile         UserProfile?
  personalMcp     PersonalMcp?
  knowledgeNodes  KnowledgeNode[]
  memories        UserMemory[]
  expertise       UserExpertise[]
  skills          UserSkill[]
  tools           UserTool[]
  agentLinks      UserAgentLink[]
  agentRuns       AgentRun[]
  stats           UserStatsRow?
  creditWallet    CreditWallet?
  creditLedger    CreditLedger[]
  lists           AgentList[]
  listShares      AgentListShare[]
}

// ---------------------------------------------------------------------------
// Agent lists (bot.muhanai.com)
// ---------------------------------------------------------------------------
// Shared shopping/todo lists that agents can read and write through the MCP
// tool surface. Distinct from CatalogItem: that model backs the marketplace,
// these are per-user mutable documents with a share code.

model AgentList {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  listType    String        @default("custom") // shopping | todo | custom
  description String?
  items       AgentListItem[]
  shares      AgentListShare[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, updatedAt])
}

model AgentListItem {
  id        String    @id @default(cuid())
  listId    String
  list      AgentList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name      String
  quantity  Float?
  note      String?
  done      Boolean   @default(false)
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([listId, done, position])
}

model AgentListShare {
  id        String    @id @default(cuid())
  listId    String
  list      AgentList @relation(fields: [listId], references: [id], onDelete: Cascade)
  code      String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([listId])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Credits
// ---------------------------------------------------------------------------

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([balance])
}

model CreditLedger {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         BigInt
  direction      String
  reason         String
  idempotencyKey String   @unique
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model UserProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String?
  description            String?
  languages              String[] @default(["en"])
  timezone               String?
  preferredJurisdiction  String[]
  avatarUrl              String?
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model UserStatsRow {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions   Int      @default(0)
  citations       Int      @default(0)
  helpfulness     Int      @default(0)
  knowledgeCount  Int      @default(0)
  memoryCount     Int      @default(0)
  expertiseDomains Int     @default(0)
  lastActiveAt    DateTime?
  updatedAt       DateTime @updatedAt
}

model PersonalMcp {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String?  // mcp://user/{userId}
  config    Json?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Category
// ---------------------------------------------------------------------------

model Category {
  id          String   @id // e.g. "real-estate" or "real-estate.rental"
  domain      String
  subdomain   String?
  description String?
  riskLevel   String   @default("medium")
  createdAt   DateTime @default(now())

  jurisdictions CategoryJurisdiction[]
  knowledge     KnowledgeNode[]

  @@index([domain])
}

model CategoryJurisdiction {
  id           String   @id @default(cuid())
  categoryId   String
  jurisdiction String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, jurisdiction])
}

// ---------------------------------------------------------------------------
// Knowledge
// ---------------------------------------------------------------------------

model KnowledgeNode {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title       String
  content     String
  sourceType  String
  visibility  String   @default("private")
  confidence  Float    @default(0.5)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks      KnowledgeChunk[]
  permissions KnowledgePermission?
  citations   KnowledgeCitation[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([visibility])
}

model KnowledgeChunk {
  id          String                       @id @default(cuid())
  knowledgeId String
  knowledge   KnowledgeNode                @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  content     String
  chunkIndex  Int
  // pgvector — enable after: CREATE EXTENSION vector;
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now())

  @@index([knowledgeId])
}

model KnowledgePermission {
  id             String        @id @default(cuid())
  knowledgeId    String        @unique
  knowledge      KnowledgeNode @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  readableBy     String[]
  usableByAgents Boolean       @default(true)
  commercialUse  Boolean       @default(false)
}

model KnowledgeCitation {
  id          String        @id @default(cuid())
  knowledgeId String
  knowledge   KnowledgeNode @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  citedBy     String?
  context     String?
  createdAt   DateTime      @default(now())

  @@index([knowledgeId])
}

// ---------------------------------------------------------------------------
// Memory / Expertise / Skills
// ---------------------------------------------------------------------------

model UserMemory {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  importance     Float     @default(0.5)
  context        Json?     // CategoryContext
  createdAt      DateTime  @default(now())
  lastAccessedAt DateTime?

  @@index([userId])
}

model UserExpertise {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain        String
  subdomain     String?
  jurisdiction  String[]
  level         Float    @default(0.1)
  evidenceCount Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, domain])
}

model UserSkill {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String?
  proficiency Float   @default(0.5)

  @@unique([userId, name])
  @@index([userId])
}

model UserTool {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  inputSchema Json?
  outputSchema Json?

  @@unique([userId, name])
}

model UserAgentLink {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId String
  name    String
  domain  String
  version String?

  @@unique([userId, agentId])
}

// ---------------------------------------------------------------------------
// Agents / MCP registry
// ---------------------------------------------------------------------------

model Agent {
  id            String   @id
  name          String
  domain        String
  subdomain     String?
  jurisdictions String[]
  description   String?
  systemPrompt  String?
  createdAt     DateTime @default(now())

  runs AgentRun[]
}

model AgentRun {
  id         String   @id @default(cuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  question   String
  output     String?
  confidence Float?
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([agentId])
}

model McpServer {
  id        String    @id @default(cuid())
  name      String
  uri       String?
  type      String // personal | expert | external
  config    Json?
  createdAt DateTime  @default(now())

  tools McpTool[]
}

model McpTool {
  id          String    @id @default(cuid())
  serverId    String
  server      McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name        String
  description String?
  inputSchema Json?
}

// ---------------------------------------------------------------------------
// Feed / Mesh (Help Needed, Verify, Human Wanted, Versus, Teach)
// ---------------------------------------------------------------------------

model HelpNeeded {
  id           String   @id @default(cuid())
  question     String
  aiConfidence Float    @default(0.5)
  humanAnswers Int      @default(0)
  reward       Int      @default(100)
  category     String
  status       String   @default("open") // open, answered, closed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  answers      HelpAnswer[]

  @@index([status, category])
  @@index([createdAt])
}

model HelpAnswer {
  id           String   @id @default(cuid())
  helpNeededId String
  helpNeeded   HelpNeeded @relation(fields: [helpNeededId], references: [id], onDelete: Cascade)
  content      String
  userId       String?
  reward       Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([helpNeededId])
}

model VerifyItem {
  id        String   @id @default(cuid())
  claim     String
  sources   Int      @default(0)
  correct   Int      @default(0)
  wrong     Int      @default(0)
  unsure    Int      @default(0)
  status    String   @default("pending") // pending, verified, rejected
  createdAt DateTime @default(now())

  @@index([status])
}

model HumanWanted {
  id          String   @id @default(cuid())
  prompt      String
  shares      Int      @default(0)
  category    String?
  createdAt   DateTime @default(now())

  @@index([shares])
}

model VersusItem {
  id              String   @id @default(cuid())
  question        String
  aiConsensus     Float    @default(0.5)
  humanConsensus  Float    @default(0.5)
  winner          String   @default("undecided") // ai, human, undecided
  aiVotes         Int      @default(0)
  humanVotes      Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([winner])
}

model TeachSubmission {
  id        String   @id @default(cuid())
  actorId   String
  content   String
  status    String   @default("verification_needed") // verification_needed, approved, rejected
  reward    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([status])
}


// ---------------------------------------------------------------------------
// P2P Network Persistence
// ---------------------------------------------------------------------------

model PeerDescriptor {
  id              String   @id // peerId
  displayName     String?
  protocol        String
  addresses       String[] // multiaddrs as JSON array
  capabilities    String[]
  metadata        Json?
  publicKey       String?  // base64 encoded Ed25519 public key
  lastSeen        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([protocol])
  @@index([updatedAt])
}

model PeerConnection {
  id          String        @id @default(cuid())
  peerId      String
  state       String        // disconnected, connecting, connected, reconnecting, closed
  connectedAt DateTime?
  latencyMs   Int?
  lastSeen    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([peerId])
  @@index([state])
}

model PeerAddress {
  id        String   @id @default(cuid())
  peerId    String
  address   String   // multiaddr string
  addedAt   DateTime @default(now())

  @@index([peerId])
  @@unique([peerId, address])
}

model VisitorPeer {
  id            String   @id // visitor id (e.g., browser-<uuid>)
  token         String   @unique
  capabilities  String[]
  path          String
  connectedAt   DateTime @default(now())
  lastSeen      DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  relayMultiaddr String?

  @@index([lastSeen])
  @@index([token])
}

model PeerReputation {
  id             String   @id // peerId
  score          Float    @default(0.0)
  alpha          Float    @default(1.0)
  beta           Float    @default(1.0)
  lastUpdated    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([score])
}

// ---------------------------------------------------------------------------
// P2P Message Queue (Redis Streams backed - persisted here for audit)
// ---------------------------------------------------------------------------

model P2PMessage {
  id          String   @id @default(cuid())
  messageId   String   @unique // P2PMessage.id
  type        String
  fromPeerId  String
  toPeerId     String
  payload      Json
  timestamp    DateTime @default(now())
  ttl          Int?      // seconds
  replyTo      String?
  signature    String?   // base64 Ed25519 signature
  status       String    @default("pending") // pending, delivered, failed, expired
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  deliveredAtNullable DateTime? @map("delivered_at")

  @@index([fromPeerId])
  @@index([toPeerId])
  @@index([status])
  @@index([timestamp])
}

model P2PMessageDelivery {
  id          String   @id @default(cuid())
  messageId   String
  toPeerId     String
  status       String   // delivered, failed
  error        String?
  deliveredAt  DateTime @default(now())

  @@index([messageId])
  @@index([toPeerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// P2P Credit Account Persistence (extends existing CreditWallet/Ledger)
// ---------------------------------------------------------------------------

model PeerCreditAccount {
  id              String   @id // peerId
  tier             String   @default("free") // free, contributor, power, unlimited
  monthlyRewards   Int      @default(0)
  baseAllocation   Int      @default(100)
  carryOverPct     Float    @default(0.5)
  balance          Int      @default(0)
  reputation       Float    @default(0.0)
  tierUpdatedAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tier])
  @@index([reputation])
}

model CreditAllocationHistory {
  id            String   @id @default(cuid())
  peerId        String
  previousTier  String?
  newTier       String
  previousBalance Int
  newBalance    Int
  monthlyRewards Int
  reputation    Float
  reason        String    // monthly_rollover, reputation_change, manual
  createdAt     DateTime  @default(now())

  @@index([peerId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// OpenTelemetry Tracing Spans (for distributed tracing audit)
// ---------------------------------------------------------------------------

model TraceSpan {
  id           String   @id @default(cuid())
  traceId      String
  spanId       String
  parentSpanId String?
  operation    String
  serviceName  String
  startTime    DateTime
  endTime      DateTime?
  durationMs   Int?
  status       String   @default("ok") // ok, error
  errorMessage String?
  attributes   Json?
  createdAt    DateTime @default(now())

  @@index([traceId])
  @@index([spanId])
  @@index([serviceName, operation])
  @@index([startTime])
}

model TraceEvent {
  id        String   @id @default(cuid())
  traceId   String
  spanId    String
  time      DateTime
  name      String
  attributes Json?
  createdAt DateTime @default(now())

  @@index([traceId])
  @@index([spanId])
  @@index([time])
}
