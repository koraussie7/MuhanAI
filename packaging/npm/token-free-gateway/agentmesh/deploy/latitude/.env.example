# ==================================================================
# Latitude self-host — muhanai production env template (110 box).
#
# Copy to .env.production on the SERVER (never commit real secrets):
#   cp .env.example .env.production
#   openssl rand -hex 32   # for every __REPLACE_WITH_RANDOM__ below
#
# Used by: docker compose --env-file .env.production -f docker-stack.yml
# The ${...} placeholders in docker-stack.yml (Temporal, healthchecks)
# are interpolated from THIS file at compose parse time.
# ==================================================================

# ---------------- Latitude infrastructure ----------------
POSTGRES_USER=latitude
POSTGRES_PASSWORD=__REPLAC…dom__
POSTGRES_DB=latitude
# Runtime user created by docker/init-db.sh (RLS-subject, used by the app)
POSTGRES_RUNTIME_USER=latitude_app
POSTGRES_RUNTIME_PASSWORD=__REPLAC…dom__

CLICKHOUSE_USER=latitude
CLICKHOUSE_PASSWORD=__REPLAC…dom__
CLICKHOUSE_DB=latitude

NODE_ENV=production

# Pin the vendored stack to a release tag (vendored against v0.3.118).
# Do NOT float to `latest` — migrations are not guaranteed forward-compatible.
LAT_IMAGE_TAG=v0.3.118

# ---------------- Latitude application ----------------
# OLAP (must match CLICKHOUSE_* above; container DNS names, not localhost)
LAT_CLICKHOUSE_URL=http://clickhouse:8123
LAT_CLICKHOUSE_USER=latitude
LAT_CLICKHOUSE_PASSWORD=__REPLAC…dom__
LAT_CLICKHOUSE_DB=latitude
LAT_CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
LAT_CLICKHOUSE_CLUSTER_ENABLED=false

# Primary Postgres: runtime (RLS) + admin (migrations/seeds) URLs
LAT_DATABASE_URL=postgres://latitude_app:__REPLAC…dom__@postgres:5432/latitude
LAT_PG_POOL_MAX=10
LAT_PG_IDLE_TIMEOUT_MS=30000
LAT_PG_CONNECT_TIMEOUT_MS=10000
LAT_ADMIN_DATABASE_URL=postgres://latitude:__REPLACE_WITH_random_pg_pwd__@postgres:5432/latitude

# Cache + BullMQ queue (bundled containers; one Redis each)
LAT_REDIS_HOST=redis
LAT_REDIS_PORT=6379
LAT_BULLMQ_HOST=redis-bullmq
LAT_BULLMQ_PORT=6379

# Temporal (bundled auto-setup, backed by the same Postgres)
LAT_TEMPORAL_ADDRESS=temporal:7233
LAT_TEMPORAL_NAMESPACE=default
LAT_TEMPORAL_TASK_QUEUE=latitude-workflows

# Object storage: `fs` driver on the shared latitude_storage named volume
# (SeaweedFS dropped — see docker-stack.yml header note 4). The root MUST
# equal the mount target in the x-app anchor (/var/lib/latitude/storage).
LAT_STORAGE_DRIVER=fs
LAT_STORAGE_FS_ROOT=/var/lib/latitude/storage

# Public URLs — must EXACTLY match what Caddy serves (see Caddyfile.latitude).
# web  -> https://prompt.kbizhub.com      (127.0.0.1:4100)
# api  -> https://prompt-api.kbizhub.com  (127.0.0.1:4101)
# ingest is loopback-only: OTLP is pushed from on-host services, so the
# advertised URL points at the published loopback port, not a hostname.
LAT_WEB_URL=https://prompt.kbizhub.com
LAT_WEB_PORT=3000
LAT_API_URL=https://prompt-api.kbizhub.com
LAT_API_PORT=3001
LAT_INGEST_URL=http://127.0.0.1:4102
LAT_INGEST_PORT=3002

# Origin allowlists — browser calls to the API are rejected without these.
LAT_TRUSTED_ORIGINS=https://prompt.kbizhub.com
LAT_CORS_ALLOWED_ORIGINS=https://prompt.kbizhub.com

# Auth / signing secrets — generate each with `openssl rand -hex 32`.
LAT_REDACTION_PSEUDONYM_SECRET=__REPLACE_WITH_random_hex32_2__
LAT_BETTER_AUTH_SECRET=__REPLACE_WITH_random_hex32_3__
# Signup is closed by default after the first user; see Latitude docs.
# LAT_DISABLE_SIGNUP=true

# Custom AI provider — the muhanai LiteLLM gateway already on the 110 box.
# Reachable from containers via the host-gateway extra_hosts entry.
LAT_CUSTOM_AI_BASE_URL=http://host.docker.internal:4003/v1
LAT_CUSTOM_AI_API_KEY=__LITELLM_VIRTUAL_KEY__

# SMTP — leave unset until email invites are actually needed.
# LAT_SMTP_HOST=smtp.example.com
# LAT_SMTP_PORT=587
# LAT_SMTP_USER=apikey
# LAT_SMTP_PASS=...
# LAT_SMTP_FROM=noreply@kbizhub.com
