{
  "name": "muhan-thin-client",
  "version": "0.1.0",
  "private": true,
  "description": "MuhanAI thin client — Electron (desktop) + Capacitor (Android) chat client over one shared React/Vite renderer. All inference runs server-side (agentmesh API). No LLM code runs locally.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "echo 'point MUHAN_API_URL at your agentmesh API (default http://localhost:3001)'",
    "dev:client": "vite",
    "build": "vite build && npm run build:electron",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/main.js && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-updater": "^6.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.muhanai.thin-client",
    "productName": "Muhan Thin Client",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!**/*.test.*",
      "!src/**",
      "!electron/**/*.test.*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "uhrichsam4",
        "repo": "muhan-thin-client",
        "vPrefixedTagName": true
      }
    ]
  }
}
