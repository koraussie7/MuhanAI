# =============================================================================
# BUILD COMMANDS
# =============================================================================
# Build CPU version:
#   docker build -t nanos:latest --target runtime .
#
# Build GPU version (requires NVIDIA Docker):
#   docker build -t nanos:cuda --target runtime-cuda --build-arg BASE_IMAGE=nvidia/cuda:12.4-devel-ubuntu22.04 .
#
# Run:
#   docker run -d \
#     --name nanos \
#     -p 8080:8080 \
#     -v /host/path/to/models:/home/nanos/models:ro \
#     -v /host/path/to/manifests:/home/nanos/manifests:ro \
#     -v /host/path/to/logs:/home/nanos/logs \
#     --restart unless-stopped \
#     --health-cmd="curl -f http://127.0.0.1:8080/health || exit 1" \
#     --health-interval=30s \
#     --health-timeout=10s \
#     --health-retries=3 \
#     nanos:latest
#
# GPU run (requires nvidia-docker):
#   docker run -d --gpus all --name nanos-gpu nanos:cuda
#
# Check logs: docker logs -f nanos
# Check health: docker inspect nanos | grep Health -A 10