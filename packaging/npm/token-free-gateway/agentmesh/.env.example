# MuhanAI AgentMesh environment variables
# Copy this file to .env and fill in your values.

# Required in production
AUTH_SECRET=your-secret-key-here
API_KEY=your-api-key-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/muhanai

# CORS
ALLOWED_ORIGINS=https://muhanai.com,https://www.muhanai.com

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# LLM Providers
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
LLM_DEFAULT_PROVIDER=openai
LLM_LOCAL_ENDPOINT=

# API Origin for MCP server to call internal services (e.g. quorum)
API_ORIGIN=http://localhost:3001

# OpenAI-compatible base URL override (scenario 2: route through OmniRoute).
# When set, the OpenAI client points at this endpoint instead of api.openai.com.
# Use this to send every "openai" provider request through a local OmniRoute
# server for quota-aware routing across 356 providers / 1,312+ models.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OPENAI_BASE_URL=http://localhost:20128/v1   # alias, lower precedence
OPENAI_DEFAULT_MODEL=gpt-4-turbo-preview
OMNIROUTE_FALLBACK_MODEL=gpt-4-turbo-preview
#
# Default model when req.model is unset. Pin to an OmniRoute-friendly id
# (e.g. "auto", "claude-opus-4", or a free-tier model id) when routing
# through OmniRoute. Falls back to "gpt-4-turbo-preview" when unset.
# OPENAI_DEFAULT_MODEL=gpt-4-turbo-preview

# ----------------------------------------------------------------------------
# Optional MCP integrations — leave empty / unset to disable each in turn.
# When a binary is missing, agents see `*_unavailable` fallback responses,
# not crashes.
# ----------------------------------------------------------------------------

# Hound (master-fetch): keyless web research across 10+ backends (DDG, Brave, ...)
# Install: `npm install -g master-fetch` or `npx master-fetch`.
HOUND_COMMAND=hound
HOUND_ARGS=
HOUND_DISABLED=

# WeKnora: hybrid vector + keyword search across configured knowledge bases.
# Requires a reachable WeKnora REST endpoint and an API key.
WEKNORA_HOST=
WEKNORA_API_KEY=

# OmniRoute: 356-provider / 1,312-model intelligent routing mesh.
# Install: `npm install -g omniroute` (provides `omniroute-mcp-server`).
# Optional: OMNIROUTE_API_KEY for authenticated upstream provider access.
OMNIROUTE_COMMAND=omniroute-mcp-server
OMNIROUTE_ARGS=
OMNIROUTE_DISABLED=
OMNIROUTE_API_KEY=

# ----------------------------------------------------------------------------
# World engine — forecasts (Pythia) + geospatial observations (ShadowBroker).
# Both are optional; unset either and the World panel falls back to the
# deterministic offline snapshot without erroring.
# ----------------------------------------------------------------------------

# Pythia World Engine REST surface (github.com/jangles-byte/Pythia).
# Powers GET /api/world/brief, /events, /predictions.
PYTHIA_WORLD_URL=http://localhost:8088

# ShadowBroker geospatial OSINT backend (github.com/BigBodyCobain/Shadowbroker).
# Powers the observation half of the world brief and feeds the correlation
# engine at GET /api/world/correlations.
# NOTE: AGPL-3.0 — exposing this over a network service triggers source
# disclosure obligations. Internal analysis only unless that is acceptable.
SHADOWBROKER_URL=http://localhost:8001
SHADOWBROKER_TOKEN=
SHADOWBROKER_AGENT_SECRET=
# Comma-separated layer allowlist; empty means "whatever upstream returns".
# Known ids: aircraft, vessels, satellites, gps_jamming, earthquakes, wildfire,
# conflict, cctv, infrastructure, news, mesh, police, sar
SHADOWBROKER_LAYERS=

# Cosmic event log — append-only JSONL. Unset keeps it in memory (dev only, and
# correlations reset on restart). Set it in production so the correlation
# engine has a time axis to work with.
COSMOS_LOG_PATH=

# ----------------------------------------------------------------------------
# Ghost node registration (POST /api/ghost/nodes) — see docs/GHOST-INTEGRATION.md
# ----------------------------------------------------------------------------

# Scoped token Ghost installs send as `x-ghost-token`. Required for node
# registration unless the platform API_KEY is used, or a non-production dev
# server runs with DISABLE_AUTH=true.
GHOST_REGISTRATION_TOKEN=

# Optional allowlist of Ghost node hosts the API may fetch Agent Cards from
# (comma-separated: `ghost.example.com`, `host:port`, `*.mesh.example.com`).
# When unset, all PUBLIC hosts are allowed — internal/loopback/link-local
# targets are always blocked, with per-hop DNS revalidation against rebinding.
GHOST_NODE_URL_ALLOWLIST=

# ----------------------------------------------------------------------------
# Rome bridge app — rome-apps/agentmesh-bridge (see docs/ROME-MIGRATION-POC.md)
# ----------------------------------------------------------------------------

# Shared bearer secret for the bridge guard. When set, the API requires
# `authorization: Bearer <token>` on protected routes (e.g. POST /api/route);
# when unset the guard is disabled for local dev. Set the SAME value on both
# sides — the API (services/api) and the Rome runtime executing the
# agentmesh-bridge app.
AGENTMESH_BRIDGE_TOKEN=

# Base URL of the agentmesh gateway the bridge calls. Defaults to
# http://127.0.0.1:3001 when unset. In Docker, point it at the compose service
# name reachable from the Rome runtime container (e.g. http://api:3001 or
# http://muhanai-api:3001) and join both composes to one user-defined network.
AGENTMESH_GATEWAY_URL=
