muhanai.com, www.muhanai.com, find.muhanai.com, travel.kbizhub.com {
	auto_https disable_redirect
	tls internal
	root * /var/www/muhanai.com/current
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Reverse-proxy /api/* to the Fastify API on port 3001.
	# Do NOT strip the /api prefix — Fastify registers routes under /api/*
	# (e.g. /api/vietnam/insight, /api/pulse, /api/auth/login).
	# Append X-Forwarded-For to preserve the client chain for Fastify's
	# trustProxy-based rate limiting.
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:3001 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@asset path_regexp asset "\.(css|js|svg|png|jpg|jpeg|webp|woff2)(\?.*)?$"
	handle @asset {
		file_server
		header Cache-Control "public, immutable, max-age=604800"
	}

	# /dashboard2 — MuhanAI Dashboard v2 (self-contained static page).
	# Must be declared as an exact-path `handle` block so it wins over the SPA
	# catch-all below (Caddy orders `handle` by path-matcher specificity).
	# `/dashboard` is intentionally NOT covered: it stays with the React SPA
	# `<Dashboard>` route. The page is a single file with inline CSS/JS, so no
	# asset routing is needed. Served with X-Frame-Options: DENY inherited from
	# the site header block — this is a top-level navigation, not an iframe embed.
	@dashboard path /dashboard2 /dashboard2/
	handle @dashboard {
		rewrite * /dashboard-v2.html
		file_server
		header Cache-Control "no-cache"
	}

	handle {
		rewrite /index.html
		file_server
	}
}

# blog.muhanai.com — Hugo static blog.
#
# DNS: blog.muhanai.com A 185.55.240.110 (Proxied / orange cloud).
# Cloudflare terminates public TLS, so the origin uses Caddy's internal CA
# (`tls internal`) — the same pattern as hotel.kbizhub.com / danang / shop1.
# Without it Caddy would try to solve a public ACME challenge behind a proxied
# hostname and the origin handshake fails (Cloudflare 525).
#
# Served straight from the origin, not via the Cloudflare Worker: the blog is a
# pure static bundle produced by deploy/build-blog.sh, and blog.muhanai.com is
# deliberately absent from wrangler.toml routes so the Worker never hijacks it.
# `current` is a symlink swapped atomically per release, so rollbacks are a
# single `ln -sfn` + reload.
blog.muhanai.com {
	tls internal
	encode zstd gzip
	root * /var/www/blog.muhanai.com/current
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@asset path_regexp asset "\.(css|js|svg|png|jpg|jpeg|webp|woff2)(\?.*)?$"
	handle @asset {
		file_server
		header Cache-Control "public, max-age=604800"
	}

	@feed path /index.xml /sitemap.xml /robots.txt
	handle @feed {
		file_server
		header Cache-Control "public, max-age=1800"
	}

	handle {
		try_files {path} {path}/ {path}.html {path}/index.html =404
		file_server
		header Cache-Control "no-cache"
	}

	log {
		output file /var/log/caddy/blog-muhanai.log
	}
}
# chat.muhanai.com — Bitterbot chat shell.
#
# chat.muhanai.com IS a Cloudflare Worker route — the Worker renders the
# chat shell HTML on "/" and proxies /assets/* to the Vite-built bundle
# (see deploy/chat-handler.ts). The Worker fronts the host with Cloudflare's
# public TLS.
#
# This Caddy block is the **origin fallback** for /assets/* requests and for
# cases where the Worker is bypassed. Because the DNS A record is proxied
# (orange cloud), Cloudflare terminates public TLS and only needs a valid
# origin certificate for the Cloudflare→origin hop. `tls internal` (Caddy's
# internal CA) is used here, matching blog.muhanai.com — Cloudflare accepts
# it in "Full" SSL mode. Without `tls` Caddy would default to ACME, which
# fails behind a proxied DNS record and produces Cloudflare 525.
#
# DNS: chat.muhanai.com A 185.55.240.110 (Proxied / orange cloud).
chat.muhanai.com {
	tls internal
	encode zstd gzip
	root * /var/www/chat.muhanai.com/current
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	@asset path_regexp asset "\.(css|js|svg|png|jpg|jpeg|webp|woff2|wasm)(\?.*)?$"
	handle @asset {
		file_server
		header Cache-Control "public, max-age=604800"
	}
	handle {
		try_files {path} {path}/ {path}.html {path}/index.html =404
		file_server
		header Cache-Control "no-cache"
	}
	log {
		output file /var/log/caddy/chat-muhanai.log
	}
}
