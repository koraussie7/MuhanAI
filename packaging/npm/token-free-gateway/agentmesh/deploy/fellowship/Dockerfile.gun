# Dockerfile for Gun.js relay node
FROM node:22-alpine

WORKDIR /app

RUN npm install gun@0.2020.1241 express@4.21.0 --no-save

EXPOSE 8081

CMD ["node", "-e", "
const express = require('express');
const Gun = require('gun');
const app = express();
const server = app.listen(8081, () => {
  console.log('Gun.js relay on :8081');
});
const gun = Gun({ web: server });
"]
