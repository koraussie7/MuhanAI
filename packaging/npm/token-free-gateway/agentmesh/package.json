{
	"name": "agentmesh",
	"version": "0.1.0",
	"private": true,
	"description": "MuhanAI AgentMesh — P2P mesh, Personal MCP, Knowledge, Category Engine",
	"license": "MIT",
	"packageManager": "pnpm@10.0.0",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "pnpm -r --filter './packages/**' run build",
		"build:api": "pnpm --filter @agentmesh/api run build",
		"typecheck": "pnpm -r run typecheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "pnpm -r run lint",
		"dev:web": "pnpm --filter @agentmesh/web run dev",
		"build:web": "pnpm --filter @agentmesh/web run build",
		"dev:api": "pnpm --filter @agentmesh/api run dev",
		"deploy:worker": "pnpm build:web && wrangler deploy",
		"clean": "pnpm -r exec rm -rf dist",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:reset": "prisma migrate reset --force",
		"demo": "tsx scripts/demo.ts",
		"demo:personal-mcp": "tsx scripts/create-personal-mcp.ts",
		"demo:integrated": "tsx scripts/integrated-demo.ts"
	},
	"dependencies": {
		"@prisma/client": "^5.22.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"prisma": "^5.22.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
