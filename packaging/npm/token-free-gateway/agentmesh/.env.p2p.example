# Public relay multiaddr returned by /api/visitors/enroll.
# Replace the peer id with the relay node's actual libp2p peer id.
VISITOR_RELAY_MULTIADDR=/dns4/relay.muhanai.com/tcp/4002/wss/p2p/<RELAY_PEER_ID>

# API/server mesh transport
P2P_DISCOVERY=bootstrap,dht
P2P_BOOTSTRAP=/dns4/seed.muhanai.com/tcp/4001/p2p/<SEED_PEER_ID>
P2P_ANNOUNCE=/dns4/api.muhanai.com/tcp/4001/p2p/<API_PEER_ID>
P2P_RELAY_SERVER=false
P2P_DHT_SERVER=false
# Seed/relay node examples
# SEED_P2P_ANNOUNCE=/dns4/seed.muhanai.com/tcp/4001/p2p/<SEED_PEER_ID>
# RELAY_P2P_ANNOUNCE=/dns4/relay.muhanai.com/tcp/4002/p2p/<RELAY_PEER_ID>
