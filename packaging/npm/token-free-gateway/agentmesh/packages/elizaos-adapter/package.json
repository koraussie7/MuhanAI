{
	"name": "@agentmesh/elizaos-adapter",
	"version": "0.1.0",
	"private": true,
	"description": "elizaOS plugin that bridges any character into the MuhanAI AgentMesh mesh (Cast / Reputation / Credits / Pulse gossip)",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./rpc": "./src/rpc.ts",
		"./plugin": "./src/plugin.ts"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	},
	"peerDependencies": {
		"@elizaos/core": "^1.0.0"
	},
	"peerDependenciesMeta": {
		"@elizaos/core": {
			"optional": true
		}
	},
	"keywords": [
		"elizaos",
		"agentmesh",
		"muhanai",
		"p2p",
		"plugin"
	],
	"license": "MIT"
}
