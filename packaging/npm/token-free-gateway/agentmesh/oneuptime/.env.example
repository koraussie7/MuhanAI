# OneUptime Configuration for MuhanAI
# Copy this to .env and fill in the values

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://oneuptime:oneuptime@localhost:5432/oneuptime

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# ClickHouse (Analytics)
# ===========================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=oneuptime
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# ===========================================
# S3/MinIO (File Storage)
# ===========================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=oneuptime
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ===========================================
# AI / LLM Provider (for Auto-Fix)
# Choose ONE:
# 1. Anthropic (Claude) - Recommended for code fixes
# 2. OpenAI (GPT-4)
# 3. Ollama (Local) - Free, private
# ===========================================

# Option 1: Anthropic (Recommended)
GLOBAL_LLM_PROVIDER=anthropic
GLOBAL_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Option 2: OpenAI
# GLOBAL_LLM_PROVIDER=openai
# GLOBAL_OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# Option 3: Ollama (Local)
# GLOBAL_LLM_PROVIDER=ollama
# GLOBAL_OLLAMA_HOST=http://host.docker.internal:11434
# GLOBAL_OLLAMA_MODEL=llama3.1:8b

# ===========================================
# GitHub App (for Auto-PR creation)
# Create at: https://github.com/settings/apps
# ===========================================
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# ===========================================
# Encryption Key (32 chars, generate with: openssl rand -hex 32)
# ===========================================
ENCRYPTION_KEY=your_32_char_encryption_key_here

# ===========================================
# Email (Optional - for notifications)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=OneUptime <noreply@yourdomain.com>

# ===========================================
# Frontend URL
# ===========================================
FRONTEND_URL=http://localhost:8000

# ===========================================
# OneUptime Specific
# ===========================================
PORT=8000
NODE_ENV=production